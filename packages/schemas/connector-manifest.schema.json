{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/connector-manifest.schema.json",
  "title": "ConnectorManifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "executor",
    "auth",
    "actions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "executor": {
      "enum": [
        "cloud",
        "local"
      ]
    },
    "endpoint": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "verification": {
      "type": "object",
      "required": [
        "environment",
        "resourceMetadata",
        "authorizationServer",
        "authorizationEndpoint",
        "tokenEndpoint"
      ],
      "additionalProperties": false,
      "properties": {
        "environment": {
          "const": "production"
        },
        "resourceMetadata": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "authorizationServer": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "authorizationEndpoint": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "tokenEndpoint": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "registrationEndpoint": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2048
        }
      }
    },
    "auth": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "none",
            "oauth2",
            "api_key",
            "bearer",
            "device",
            "custom"
          ]
        },
        "header": {
          "type": "string",
          "description": "Header carrying the credential. Absent means Authorization.",
          "pattern": "^[A-Za-z0-9-]+$",
          "maxLength": 64
        },
        "scheme": {
          "type": "string",
          "description": "Prefix before the credential. Absent means 'Bearer ' for Authorization, nothing otherwise.",
          "maxLength": 32
        },
        "fields": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "name",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,39}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "hint": {
                "type": "string",
                "maxLength": 240
              },
              "secret": {
                "type": "boolean"
              },
              "required": {
                "type": "boolean"
              },
              "placeholder": {
                "type": "string",
                "maxLength": 200
              },
              "role": {
                "enum": [
                  "endpoint",
                  "credential"
                ]
              }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "objectSchema": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "object" }
      }
    },
    "action": {
      "$anchor": "action",
      "title": "ActionDefinition",
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "inputSchema",
        "risk",
        "annotations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,127}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "inputSchema": {
          "$ref": "#/$defs/objectSchema"
        },
        "outputSchema": {
          "$ref": "#/$defs/objectSchema"
        },
        "risk": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3",
            "R4"
          ]
        },
        "annotations": {
          "type": "object",
          "required": [
            "readOnly",
            "destructive"
          ],
          "properties": {
            "readOnly": {
              "type": "boolean"
            },
            "destructive": {
              "type": "boolean"
            },
            "idempotent": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "requiredScopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "x-upstream": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the tool to invoke on the upstream server, for connector types that proxy an existing published tool surface (remote MCP). Optional: a connector whose adapter implements the action itself declares none. The gateway NEVER derives this from the action id \u2014 an action that proxies and omits it is ACTION_NOT_FOUND, because a guessed name can resolve to a different real tool."
        }
      },
      "additionalProperties": true
    }
  }
}
