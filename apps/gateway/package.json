{
  "name": "@cg/gateway",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Public runtime edge: MCP/REST for AI clients + device relay for local agents.",
  "//exports": "Only ./edge is public. It is the host-agnostic surface apps/web mounts on Next.js (docs/20); main.ts stays unreachable from an import so no Bun global can enter a Next build.",
  "exports": {
    "./edge": "./src/edge.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "keygen": "bun src/scripts/keygen.ts",
    "seal": "bun src/scripts/seal.ts"
  },
  "dependencies": {
    "@cg/adapter-blender": "workspace:*",
    "@cg/adapter-remote-mcp": "workspace:*",
    "@cg/auth": "workspace:*",
    "@cg/core": "workspace:*",
    "@cg/executor": "workspace:*",
    "@cg/observability": "workspace:*",
    "@cg/policy": "workspace:*",
    "@cg/protocol": "workspace:*",
    "@cg/registry": "workspace:*",
    "@cg/schemas": "workspace:*",
    "convex": "1.44.0",
    "@cg/transport": "workspace:*"
  }
}
